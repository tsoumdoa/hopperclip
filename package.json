{
	"name": "hopperclip",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.23.0",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
		"preview": "vite preview",
		"start": "node .output/server/index.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "eslint . && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
		"test": "vitest",
		"convex:generate": "convex dev --once"
	},
